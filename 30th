#include <stdio.h>
#include <ctype.h>

int main() {
    char s[100];
    int i,c=0;
    fgets(s,100,stdin);

    for(i=0;s[i];i++) {
        char x=tolower(s[i]);

        if(x>='a' && x<='z' &&
           x!='a' && x!='e' && x!='i' &&
           x!='o' && x!='u')
            c++;
    }

    printf("Consonants = %d",c);
    return 0;
}
